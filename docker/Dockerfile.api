FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml requirements.txt ./
COPY packages/ packages/
COPY wiki/ wiki/
COPY sources/ sources/
COPY templates/ templates/
COPY AGENTS.md llm-wiki.md ./

RUN pip install --no-cache-dir -e ".[api]" && pip install --no-cache-dir -r requirements.txt

ENV WIKI_BASE_DIR=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "wiki_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
