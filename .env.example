# OpenRouter API Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary OpenRouter Model
OPENROUTER_MODEL=openrouter/free

# Fallback Models (comma-separated)
OPENROUTER_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free

# API Server
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
REQUIRE_AUTH=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite local, PostgreSQL on Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/wiki

# CLI remote mode (set after `wiki login`)
# WIKI_API_URL=http://localhost:8000
# WIKI_API_TOKEN=
