# --- Auth (required) ---------------------------------------------------------
# Generate a secret with: openssl rand -hex 32
# Required in production: startup refuses to boot against a hosted database while this is
# still the built-in default, because that value is public and tokens would be forgeable.
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# How long a login lasts, in minutes (default 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ----------------------------------------------------------------
# Railway sets DATABASE_URL automatically. Docker Compose sets it too.
# DATABASE_URL=postgresql://wiki:wiki@db:5432/wiki
# Keep the pool small — one container, one uvicorn worker.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Startup waits for the database before serving; these bound that wait.
# DB_CONNECT_ATTEMPTS=12
# DB_CONNECT_MAX_BACKOFF=5

# --- LLM (optional — needed for Ask AI and summaries) -------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Leave both blank to auto-select a working free model from OpenRouter's live catalogue.
# Model ids go stale quickly; check https://openrouter.ai/models or GET /api/llm/models.
# Free models allow 50 requests/day (1,000/day after a one-time $10 credit purchase).
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

# --- Speech to text (optional — for videos with no captions) ------------------
# openai: ~$0.006/min. deepgram: ~$0.004/min. Roughly $0.36 per hour of audio.
STT_PROVIDER=openai
OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# STT_MODEL=whisper-1

# --- Background jobs (optional) ----------------------------------------------
# Keep concurrency low on a small Railway container: RAM is ~85% of the bill.
# JOB_CONCURRENCY=2
# MAX_PENDING_JOBS=20
# JOB_TIMEOUT_SECONDS=1800
# How long shutdown waits for in-flight jobs. Railway SIGKILLs ~30s after SIGTERM.
# SHUTDOWN_GRACE_SECONDS=25
# JOB_POLL_INTERVAL=10

# --- Misc (optional) ----------------------------------------------------------
# LOG_LEVEL=INFO
# STATIC_DIR=/app/static
# WIKI_SEED_DIR=/app
