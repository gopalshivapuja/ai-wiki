# OpenRouter API Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary: Nemotron 3 Ultra — best free model for reasoning, RAG, and long-context wiki work
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Fallbacks (tried in order if primary is rate-limited or unavailable)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,openrouter/free

# API Server
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
REQUIRE_AUTH=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite local, PostgreSQL on Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/wiki

# CLI remote mode (set after `wiki login`)
# WIKI_API_URL=http://localhost:8000
# WIKI_API_TOKEN=
