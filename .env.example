# Copy to .env for local development. Docker Compose reads this file directly.

# --- Required -----------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Leave this EMPTY here. Startup refuses to boot against a hosted database while the
# built-in default is still in place, and a placeholder committed to a repo is no safer
# than the default it replaces.
JWT_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Railway sets this automatically. Compose sets it too.
# DATABASE_URL=postgresql://wiki:wiki@db:5432/wiki


# --- AI (optional; without it, search and notes work but Ask AI does not) ------

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Leave both blank to auto-select a working free model from OpenRouter's live catalogue.
# Model ids go stale quickly — a stale pinned id is why Ask AI once failed outright.
# Check GET /api/llm/models to see what was chosen. Free models allow 50 requests/day,
# or 1,000/day after a one-time $10 credit purchase.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=


# --- Speech to text (optional; for videos with no captions) --------------------

# openai ≈ $0.006/min, deepgram ≈ $0.004/min — about $0.36 per hour of audio.
# Note that YouTube frequently blocks audio downloads from cloud servers.
STT_PROVIDER=openai
OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# OPENAI_STT_MODEL=whisper-1
# DEEPGRAM_STT_MODEL=nova-2


# --- Tuning (all have working defaults) ---------------------------------------

# LOG_LEVEL=INFO
# ACCESS_TOKEN_EXPIRE_MINUTES=10080     # how long a login lasts (7 days)

# Database. Keep the pool small: one container, one uvicorn worker.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Startup waits for the database before serving; these bound that wait.
# DB_CONNECT_ATTEMPTS=12
# DB_CONNECT_MAX_BACKOFF=5

# Background jobs. One worker per process — reap_orphans assumes exactly one runner,
# so set JOB_RUNNER_ENABLED=0 in any additional web-only process.
# JOB_RUNNER_ENABLED=1
# JOB_TIMEOUT_SECONDS=1800
# JOB_POLL_INTERVAL=10
# SHUTDOWN_GRACE_SECONDS=25             # Railway SIGKILLs ~30s after SIGTERM

# Paths. The Docker image sets both.
# STATIC_DIR=/app/static
# WIKI_SEED_DIR=/app
