# OpenRouter API Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary OpenRouter Model (openrouter/free automatically routes to best available free model)
OPENROUTER_MODEL=openrouter/free

# Fallback Models (tried in order if primary returns error/rate-limit)
OPENROUTER_FALLBACK_MODELS=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free
