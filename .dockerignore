# Keep the build context small and, more importantly, correct.
#
# node_modules is the dangerous one: the Dockerfile runs `npm ci` for linux and then
# COPYs apps/web/ over it. Without this file a local `railway up` or `docker build` would
# overwrite the linux install with the host's (e.g. darwin-arm64) binaries, and the Vite
# build fails with "Cannot find module @rollup/rollup-linux-x64-gnu".
node_modules
**/node_modules

# Virtualenvs and caches — 100MB+ of pure upload cost.
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
*.egg-info

# Build output: the image builds its own.
dist
**/dist
static
*.tsbuildinfo

.git
.github
.cursor

# Never bake secrets or local databases into an image.
.env
.env.*
!.env.example
*.db

.DS_Store
*.tmp
